# ====================
# Model Source & Cache
# ====================
# 模型来源（modelscope / huggingface）
MINERU_MODEL_SOURCE=modelscope
# ModelScope 离线模式（1=启用）
MODELSCOPE_OFFLINE=1
# ModelScope 模型缓存路径
MODELSCOPE_CACHE=C:/ai_models/modelscope_cache
# Hugging Face 缓存路径
HF_HOME=C:/ai_models/huggingface_cache
# 临时文件根目录
MD_ROOT_DIR=./temp-files/

# ====================
# OpenAI / LLM API (SiliconFlow 硅基流动，OpenAI 兼容接口)
# ====================
# 【必填】API 密钥（硅基流动控制台创建，sk- 开头）
OPENAI_API_KEY=<your-siliconflow-api-key>
# API 基础地址（硅基流动）
OPENAI_API_BASE=https://api.siliconflow.cn/v1
# 默认 LLM 模型
LLM_DEFAULT_MODEL=Qwen/Qwen3-8B
# 默认温度参数（0-1，越低越稳定）
LLM_DEFAULT_TEMPERATURE=0.1
# 视觉语言模型（文档图片转描述用）
VL_MODEL=Qwen/Qwen3-VL-8B-Instruct
# 商品名识别模型
ITEM_MODEL=Qwen/Qwen3-8B

# ====================
# BGE Embedding Models
# ====================
# BGE-M3 模型本地路径
BGE_M3_PATH=C:/models/bge-m3
# BGE-M3 模型名称
BGE_M3=BAAI/bge-m3
# 嵌入模型运行设备（cuda:0 / cpu）
BGE_DEVICE=cuda:0
# 是否使用半精度（True/False）
BGE_FP16=True
# BGE 重排序模型路径
BGE_RERANKER_LARGE=C:/models/bge-reranker-large
# 重排序模型设备
BGE_RERANKER_DEVICE=cuda:0
# 重排序模型半精度
BGE_RERANKER_FP16=1

# ====================
# Embedding General
# ====================
# 嵌入向量维度（本地 BGE-M3 dense 为 1024）
EMBEDDING_DIM=1024

# ====================
# Vector Database (Milvus)
# ====================
# Milvus 连接地址
MILVUS_URL=http://localhost:19530
# 知识库切片集合名
CHUNKS_COLLECTION=kb_chunks
# 商品名称集合名
ITEM_NAME_COLLECTION=kb_item_names
# 相似度度量方式
MILVUS_METRIC_TYPE=COSINE
# 最小余弦相似度阈值
MILVUS_MIN_COSINE_SCORE=0.75

# ====================
# Retrieval Tuning (检索召回调参，留空则用代码内置默认值)
# ====================
# 混合向量检索单路召回条数（默认 15；过小会漏召回相关切片）
EMBEDDING_SEARCH_LIMIT=15
# HyDE 检索单路召回条数（默认 15）
HYDE_SEARCH_LIMIT=15
# RRF 融合后保留的候选条数（默认 20，作为 rerank 的输入池）
RRF_K=60
RRF_MAX_RESULTS=20
# rerank 动态截断的上下界（默认 3 / 10，最终进入 prompt 的切片数由此收敛）
RERANK_MIN_TOP_K=3
RERANK_MAX_TOP_K=10
# 知识图谱反查在 RRF 融合中的权重（默认 0.8）
KG_RRF_WEIGHT=0.8

# ====================
# Document Database (MongoDB)
# ====================
# 【注意】用户名/密码需与 docker-compose.yml 的 MONGO_INITDB_ROOT_* 一致
MONGO_URL=mongodb://<mongo-user>:<mongo-pass>@localhost:27017
# 数据库名
MONGO_DB_NAME=kb001

# ====================
# Object Storage (MinIO)
# ====================
# MinIO 服务端点
MINIO_ENDPOINT=localhost:9000
# 【注意】账号/密码需与 docker-compose.yml 的 MINIO_ACCESS_KEY / MINIO_SECRET_KEY 一致
MINIO_ACCESS_KEY=<your-minio-access-key>
MINIO_SECRET_KEY=<your-minio-secret-key>
# 存储桶名称
MINIO_BUCKET_NAME=knowledge-base

# ====================
# Other / MCP Services
# ====================
# MCP Web 搜索服务地址（阿里云百炼；硅基流动不提供联网搜索 MCP）
# Streamable HTTP 端点以 /mcp 结尾；SSE 端点以 /sse 结尾
MCP_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/mcp
# 【选填】联网搜索专用阿里云 DashScope key（与硅基流动 key 分离；留空则回退用 OPENAI_API_KEY，
# 回退时联网搜索会因鉴权失败被跳过，不影响主链路）
MCP_DASHSCOPE_API_KEY=<your-dashscope-api-key>

# ====================
# Knowledge Graph (Neo4j)
# ====================
# Neo4j 连接 URI（bolt 协议）
NEO4J_URI=bolt://localhost:7687
# Neo4j 用户名（与 docker-compose.yml 的 NEO4J_AUTH 一致）
NEO4J_USERNAME=neo4j
# 【必填】Neo4j 密码（务必与 docker-compose.yml 的 NEO4J_AUTH 保持一致）
NEO4J_PASSWORD=<your-neo4j-password>
# Neo4j 数据库名
NEO4J_DATABASE=neo4j
# 实体名称向量集合（Milvus，供知识图谱实体对齐使用；导入/查询两端共用此变量）
ENTITY_NAME_COLLECTION=kb_entity_names

# ====================
# UIE 知识图谱实体/关系抽取（独立微服务）
# ====================
# 说明：UIE(paddlenlp) 与 pymilvus 的 protobuf 冲突，故抽取跑在 uie_service/ 独立 venv
# 的 HTTP 微服务里，主项目通过下列地址调用。服务未启动时自动降级走远程 LLM 兜底。
# UIE 微服务地址
UIE_SERVICE_URL=http://127.0.0.1:8001
# 单次请求超时（秒）；GPU 实测约 6.5s/次，但多 chunk 串行排队需留余量
UIE_TIMEOUT=120
# 是否启用 UIE（False 则直接返回空，强制走 LLM 兜底）
UIE_ENABLED=True
# ---- 以下仅在 uie_service/ 服务进程读取（启动 uvicorn 前设置到环境）----
# UIE 模型本地路径（与其它模型统一放本地；留空则用内置 uie-base 首次自动下载）
UIE_MODEL_PATH=C:/models/uie-base
# UIE 抽取置信度阈值（0-1，越高越严格）
UIE_PRECISION=0.5

# ====================
# RAGAS 评测（knowledge/evaluation/*，CLI: knowledge/evaluation/run_ragas_eval.py）
# ====================
# 两步独立、使用方自行编排：
#   expand  : 读 docs/ 下 .md/.txt 逐篇出题并跑查询链路补齐 → 产出四元组 JSON
#   evaluate: 把四元组 JSON 喂给 RAGAS 四维打分
#
# 参与评估的指标（逗号分隔，留空=四维全开）：
#   faithfulness,answer_relevancy,context_precision,context_recall
EVAL_METRICS=
# ragas 内部并发度（单样本多断言的并行 LLM 调用数）
EVAL_MAX_WORKERS=4

# ---- 数据扩展（文档驱动） ----
# 文档目录（默认项目根下的 docs/，读取 .md/.txt；PDF 请先用导入流程转好 md）
EVAL_DOCS_DIR=
# 每篇文档目标产出的问答对数量
EVAL_QA_PER_DOC=15
# 每个文档片段最多生成的问答对数（把每篇数量摊到多个片段）
EVAL_QA_PER_CHUNK=2
# 送入 LLM 出题的文档片段长度 / 重叠长度（字符）
EVAL_DOC_CHUNK_CHARS=1200
EVAL_DOC_CHUNK_OVERLAP=150

# ---- 评估运行时 ----
# 每条样本送入评测的上下文条数（取 rerank 后文档）
EVAL_CONTEXT_TOP_K=5

# ---- 评估模型（与链路模型解耦，避免自己评自己） ----
# 评判模型名（留空则回退 LLM_DEFAULT_MODEL）；建议换成与链路不同的模型，如 DeepSeek 系列：
#   deepseek-ai/DeepSeek-V3
EVAL_LLM_MODEL=
# 默认复用链路的硅基流动 base/key；如需彻底隔离再单独配置以下两项
EVAL_LLM_API_BASE=
EVAL_LLM_API_KEY=
# 评判温度（默认 0，越低越稳定）
EVAL_LLM_TEMPERATURE=0
